        <fechas>
            <inicio>
                <dia>15</dia>
                <mes>09</mes>
                <ano>2025</ano>
            </inicio>
            <fin>
                <dia>22</dia>
                <mes>06</mes>
                <ano>2026</ano>
            </fin>
        </fechas>
    </modulo>
</cfgs>