<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE cfgs [
    <!ELEMENT cfgs (modulo+)>
    <!ATTLIST cfgs nombre CDATA #REQUIRED>
    
    <!ELEMENT modulo (nombre, descripcion, codigo, profesor, fechas)>
    <!ELEMENT nombre (#PCDATA)>
    <!ELEMENT descripcion (#PCDATA)>
    <!ELEMENT codigo (#PCDATA)>
    <!ELEMENT profesor (#PCDATA)>
    
    <!ELEMENT fechas (inicio, fin)>
    <!ELEMENT inicio (dia, mes, ano)>
    <!ELEMENT fin (dia, mes, ano)>
    
    <!ELEMENT dia (#PCDATA)>
    <!ELEMENT mes (#PCDATA)>
    <!ELEMENT ano (#PCDATA)>
]>

